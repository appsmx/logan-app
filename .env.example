# LOGAN OS — example environment variables.
# Copy to .env and fill in for your environment.
# On Vercel/production, set these as Vercel env vars.

# Database (Neon Postgres on Vercel — auto-configured by Neon integration)
DATABASE_URL="file:./db/custom.db"

# LLM providers (at least one required).
# Both ZAI_API_KEY and GEMINI_API_KEY are read directly. If you have multiple
# projects in the same Vercel team and want namespace isolation, you can use
# loganZAI_API_KEY / loganGEMINI_API_KEY instead — they take precedence.
#
# Z.ai (GLM-5.x + 4.6) — https://z.ai/model-api
# Required if you want GLM models. DEC-LOGAN-017: glm-5.2 for Core/Dev,
# glm-5.1 for Design/Analytics/Legal, glm-5-turbo for the rest. Falls back
# to glm-4.6 then to Gemini on error (429/404/etc.).
ZAI_API_KEY=your_zai_api_key_here
# loganZAI_API_KEY=your_namespaced_zai_key   # alternative if you need isolation

# Google Gemini (2.0 Flash) — https://aistudio.google.com/app/apikey (free tier)
# Free 1,500 requests/day. Used as the safety-net fallback when Z.ai is unavailable
# or out of credits. Configure this FIRST if you want LOGAN to work for free.
GEMINI_API_KEY=your_gemini_api_key_here
# loganGEMINI_API_KEY=your_namespaced_gemini_key  # alternative if you need isolation

# GitHub integration (LOGAN git tools)
GITHUB_TOKEN=your_github_token_here
LOGAN_ALLOWED_REPOS=mrtramite,mariscosquiroa,logan-app
LOGAN_GITHUB_OWNER=appsmx

# Vercel integration (LOGAN deploy tools — optional)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_SLUG=appsmx
