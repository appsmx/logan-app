# LOGAN OS — example environment variables.
# Copy to .env and fill in for your environment.
# On Vercel/production, set these as Vercel env vars.

# SQLite (local dev) — replace with Postgres URL on Vercel.
DATABASE_URL="file:./db/custom.db"

# GitHub integration (LOGAN git tools)
GITHUB_TOKEN=your_github_token_here
LOGAN_ALLOWED_REPOS=mrtramite
LOGAN_GITHUB_OWNER=appsmx

# Vercel integration (LOGAN Vercel tools — Task 32)
# VERCEL_TOKEN: API token from https://vercel.com/account/tokens (project scope).
# VERCEL_TEAM_SLUG: optional — leave blank for personal account, or set to the
#   team slug (find it at https://vercel.com/dashboard → switch team → check URL).
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_SLUG=your_team_slug_here
